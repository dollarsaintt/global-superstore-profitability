  <worksheets>
    <worksheet name="Data Quality Check">
      <table>
        <view>
          <datasources>
            <datasource caption="Sheet1 (Global_Superstore2)" name="federated.0hhcszr1y865xa156evqa1bap6nc"/>
          </datasources>
          <datasource-dependencies datasource="federated.0hhcszr1y865xa156evqa1bap6nc">
            <column caption="Missing Order Dates." datatype="integer" name="[Calculation_2321605160910849]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF ISNULL([Order Date]) THEN 1 ELSE 0 END)"/>
            </column>
            <column caption="Missing Ship Dates" datatype="integer" name="[Calculation_2321605161521154]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF ISNULL([Ship Date]) THEN 1 ELSE 0 END)"/>
            </column>
            <column caption="Shipping Dates Error" datatype="integer" name="[Calculation_2321605161979907]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(IF [Ship Date] &lt; [Order Date] THEN 1 ELSE 0 END)"/>
            </column>
            <column caption="Rows with missing measures " datatype="integer" name="[Calculation_2321605162328068]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#10;    IF ISNULL([Sales])&#10;    OR ISNULL([Profit])&#10;    OR ISNULL([Quantity])&#10;    OR ISNULL([Discount])&#10;    OR ISNULL([Shipping Cost])&#10;    THEN 1 ELSE 0 END&#10;)"/>
            </column>
            <column caption="Invalid Discount " datatype="integer" name="[Calculation_2321605162975237]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#10;    IF [Discount] &lt; 0 OR [Discount] &gt; 1&#10;    THEN 1 ELSE 0 END&#10;)"/>
            </column>
            <column caption="Rows to Review" datatype="integer" name="[Calculation_2321605163360262]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#10;    IF [Sales] &lt;= 0&#10;    OR [Quantity] &lt;= 0&#10;    OR [Quantity] &lt;&gt; INT([Quantity])&#10;    OR [Shipping Cost] &lt; 0&#10;    THEN 1 ELSE 0 END&#10;)"/>
            </column>
            <column caption="Missing Analysis Categories " datatype="integer" name="[Calculation_2321605164953607]" role="measure" type="quantitative">
              <calculation class="tableau" formula="SUM(&#10;    IF IFNULL(TRIM([Category]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Sub-Category]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Market]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Region]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Country]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Segment]), &quot;&quot;) = &quot;&quot;&#10;    THEN 1 ELSE 0 END&#10;)"/>
            </column>
            <column datatype="string" name="[Category]" role="dimension" type="nominal"/>
            <column datatype="string" name="[Country]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal"/>
