      <aliases enabled="yes"/>
      <column caption="Missing Order Dates." datatype="integer" name="[Calculation_2321605160910849]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF ISNULL([Order Date]) THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Missing Ship Dates" datatype="integer" name="[Calculation_2321605161521154]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF ISNULL([Ship Date]) THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Shipping Dates Error" datatype="integer" name="[Calculation_2321605161979907]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(IF [Ship Date] &lt; [Order Date] THEN 1 ELSE 0 END)"/>
      </column>
      <column caption="Rows with missing measures " datatype="integer" name="[Calculation_2321605162328068]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(&#10;    IF ISNULL([Sales])&#10;    OR ISNULL([Profit])&#10;    OR ISNULL([Quantity])&#10;    OR ISNULL([Discount])&#10;    OR ISNULL([Shipping Cost])&#10;    THEN 1 ELSE 0 END&#10;)"/>
      </column>
      <column caption="Invalid Discount " datatype="integer" name="[Calculation_2321605162975237]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(&#10;    IF [Discount] &lt; 0 OR [Discount] &gt; 1&#10;    THEN 1 ELSE 0 END&#10;)"/>
      </column>
      <column caption="Rows to Review" datatype="integer" name="[Calculation_2321605163360262]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(&#10;    IF [Sales] &lt;= 0&#10;    OR [Quantity] &lt;= 0&#10;    OR [Quantity] &lt;&gt; INT([Quantity])&#10;    OR [Shipping Cost] &lt; 0&#10;    THEN 1 ELSE 0 END&#10;)"/>
      </column>
      <column caption="Missing Analysis Categories " datatype="integer" name="[Calculation_2321605164953607]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM(&#10;    IF IFNULL(TRIM([Category]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Sub-Category]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Market]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Region]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Country]), &quot;&quot;) = &quot;&quot;&#10;    OR IFNULL(TRIM([Segment]), &quot;&quot;) = &quot;&quot;&#10;    THEN 1 ELSE 0 END&#10;)"/>
      </column>
      <column caption="Profit Margin" datatype="real" default-format="p0.0%" name="[Calculation_3875215099113473]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([Profit]) / SUM([Sales])"/>
      </column>
      <column caption="Profit Status" datatype="string" name="[Calculation_3875215101255683]" role="measure" type="nominal">
        <calculation class="tableau" formula="IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot;&#10;ELSE &quot;Profit or Break-even&quot;&#10;END"/>
      </column>
      <column caption="Discount Band" datatype="string" name="[Calculation_3875215103918084]" role="dimension" type="nominal">
        <calculation class="tableau" formula="IF [Discount] = 0 THEN &quot;1. No discount&quot;&#10;ELSEIF [Discount] &lt;= 0.10 THEN &quot;2. Over 0%–10%&quot;&#10;ELSEIF [Discount] &lt;= 0.20 THEN &quot;3. Over 10%–20%&quot;&#10;ELSEIF [Discount] &lt;= 0.30 THEN &quot;4. Over 20%–30%&quot;&#10;ELSEIF [Discount] &lt;= 0.50 THEN &quot;5. Over 30%–50%&quot;&#10;ELSE &quot;6. Over 50%–100%&quot;&#10;END"/>
      </column>
      <column datatype="string" name="[City]" role="dimension" semantic-role="[City].[Name]" type="nominal"/>
      <column datatype="string" name="[Country]" role="dimension" semantic-role="[Country].[ISO3166_2]" type="nominal"/>
      <column datatype="real" default-format="p0.0%" name="[Discount]" role="measure" type="quantitative"/>
      <column aggregation="Sum" datatype="integer" default-format="*00000" name="[Postal Code]" role="dimension" semantic-role="[ZipCode].[Name]" type="ordinal"/>
      <column datatype="integer" name="[Row ID]" role="dimension" type="ordinal"/>
      <column datatype="string" name="[State]" role="dimension" semantic-role="[State].[Name]" type="nominal"/>
      <column caption="Sheet1" datatype="table" name="[__tableau_internal_object_id__].[Sheet1_0EB7156FE07243419A42AD8E1EA67C88]" role="measure" type="quantitative"/>
      <column-instance column="[Calculation_3875215103918084]" derivation="None" name="[none:Calculation_3875215103918084:nk]" pivot="key" type="nominal"/>
      <column-instance column="[Calculation_3875215101255683]" derivation="User" name="[usr:Calculation_3875215101255683:nk]" pivot="key" type="nominal"/>
      <layout dim-ordering="alphabetic" measure-ordering="alphabetic" show-structure="true"/>
      <style>
        <style-rule element="mark">
          <encoding attr="color" field="[usr:Calculation_3875215101255683:nk]" type="palette">
            <map to="#4e79a7">
              <bucket>"Profit or Break-even"</bucket>
            </map>
            <map to="#f28e2b">
              <bucket>"Loss"</bucket>
            </map>
          </encoding>
          <encoding attr="color" field="[none:Calculation_3875215103918084:nk]" type="palette">
            <map to="#2a5783">
              <bucket>"1. No discount"</bucket>
            </map>
            <map to="#5b8cb8">
              <bucket>"2. Over 0\%–10\%"</bucket>
            </map>
            <map to="#89b8da">
              <bucket>"3. Over 10\%–20\%"</bucket>
            </map>
            <map to="#acb0b1">
              <bucket>"4. Over 20\%–30\%"</bucket>
